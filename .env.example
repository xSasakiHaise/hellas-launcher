# === Hellas Launcher .env ===
# Copy this file to .env and edit the values.

# Links
WEBSITE_URL=https://hellasregion.com
DYNMAP_URL=https://map.hellasregion.com

# Microsoft device login
# Public client id for the launcher registration.
MICROSOFT_CLIENT_ID=

# New WordPress-hosted MC 1.21.1 manifest.
# The launcher has this URL as a built-in fallback, but keeping it here makes local dev explicit.
# Leave PACK_MANIFEST_URL blank so MC 1.16.5 stays on the old WordPress plugin.
PACK_MANIFEST_URL=

# Legacy modpack update source for MC 1.16.5.
# If all source values are blank, MC 1.16.5 falls back to the built-in latest compact URL.
# Feed JSON: {"version":"1.3.0","url":"https://hellasregion.com/download/launcher/latest/compact","sha256":"optionalhex"}
PACK_FEED_URL=
PACK_ZIP_URL=
PACK_VERSION=
PACK_EXPECTED_SHA256=

# Optional profile-specific update sources. Use the 1.21.1 manifest for the new plugin.
PACK_MANIFEST_URL_1_16_5=
PACK_MANIFEST_URL_1_21_1=https://hellasregion.com/wp-json/hellas-launcher-1211/v1/manifest
PACK_FEED_URL_1_16_5=
PACK_FEED_URL_1_21_1=
PACK_ZIP_URL_1_16_5=
PACK_ZIP_URL_1_21_1=
PACK_VERSION_1_16_5=
PACK_VERSION_1_21_1=
PACK_EXPECTED_SHA256_1_16_5=
PACK_EXPECTED_SHA256_1_21_1=

# Optional Java 8 runtime zip override for reinstalling bundled Java 8.
JAVA8_ZIP_PATH=
JAVA21_ZIP_PATH=

# Optional Java executable overrides per profile.
JAVA8_PATH=
JAVA21_PATH=

# Optional memory overrides in MB.
MC_MEMORY_MIN=
MC_MEMORY_MAX=

# Animation default (true = enabled on first run)
AETHERVEIL_ANIM_ENABLED=true
