# === Hellas Launcher .env ===
# Copy this file to .env and edit the values.

# Links
WEBSITE_URL=https://hellasregion.com
DYNMAP_URL=https://map.hellasregion.com

# Microsoft device login
# Public client id for the launcher registration.
MICROSOFT_CLIENT_ID=

# Legacy modpack update source
# If PACK_FEED_URL is blank, the launcher falls back to the built-in latest compact URL.
# Feed JSON: {"version":"1.3.0","url":"https://hellasregion.com/download/launcher/latest/compact","sha256":"optionalhex"}
PACK_FEED_URL=
PACK_ZIP_URL=
PACK_VERSION=
PACK_EXPECTED_SHA256=

# Optional Java 8 runtime zip override for reinstalling bundled Java 8.
JAVA8_ZIP_PATH=

# Optional memory overrides in MB.
MC_MEMORY_MIN=
MC_MEMORY_MAX=

# Animation default (true = enabled on first run)
AETHERVEIL_ANIM_ENABLED=true
